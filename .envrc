watch_file rust-toolchain.toml
use flake

# Every worktree's devcontainer shares one nix store volume, but nix-direnv's GC
# roots point into /workspace/.direnv, which each container resolves to its own
# worktree. Root this worktree's store paths directly, so garbage collecting in
# one container doesn't delete another's dev shell.
if [[ -n "${WORKSPACE_DIR:-}" ]]; then
    roots=/nix/var/nix/gcroots/cookit/$WORKSPACE_DIR
    mkdir -p "$roots"
    declare -A keep=()
    # Add new roots before pruning old ones, so there is no unrooted window.
    for link in .direnv/flake-profile-* .direnv/flake-inputs/*; do
        target=$(readlink -f "$link")
        [[ "$target" == /nix/store/* ]] || continue
        keep[${target##*/}]=1
        ln -sfn "$target" "$roots/${target##*/}"
    done
    for root in "$roots"/*; do
        [[ -n "${keep[${root##*/}]:-}" ]] || rm -f "$root"
    done
fi
