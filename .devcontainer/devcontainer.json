{
  "name": "CookIt!",
  "dockerComposeFile": "docker-compose.yml",
  "service": "cookit",
  "workspaceFolder": "/workspace",
  "initializeCommand": ".devcontainer/initialize.sh",
  "postCreateCommand": ".devcontainer/post_create.sh",
  "postStartCommand": ".devcontainer/post_start.sh",
  "forwardPorts": [
    8080
  ],
  "customizations": {
    "devconcurrent": {
      "env": {
        "DATABASE_URL": "postgres://postgres:postgres@{{ hostname 'postgres' }}:5432/cookit_dev",
        "BASE_DOMAIN": "{{ hostname 'cookit' }}"
      },
      "proxy": {
        "enable": true,
        "services": {
          "cookit": {
            "hostname": "{{workspace}}.test",
            "containerPort": 8080
          },
          "jaeger": {
            "containerPort": 16686
          }
        }
      }
    }
  }
}